# Templated (not a plain .conf) so `${WOLF_API_PORT}` below is filled in by
# the nginx base image's docker-entrypoint.d/20-envsubst-on-templates.sh at
# container start, from the WOLF_API_PORT env var set on the wolf-web
# service in docker-compose.yml. Default matches .env.example (8100) if
# unset. wolf-api shares dind's netns (see docker-compose.yml comments), so
# "dind" is the only compose-DNS name that reaches it — matches
# deploy/web.nginx.conf's `proxy_pass http://dind:8099` in the agent-orange
# repo, same indirection, different target.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback.
    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://dind:${WOLF_API_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # SSE-friendly: the Orange chat iframe streams over SSE, and Wolf's
        # own poller/status endpoints may too — never buffer either.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location /mcp {
        proxy_pass http://dind:${WOLF_API_PORT}/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }
}
